{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.
  Versión BIF: título y descripción de la portada, imagen para compartir por defecto,
  textos en español y "noindex" en páginas filtradas por etiqueta y en la búsqueda.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content="#477E33"
>

{%- liquid
  assign seo_title = page_title
  assign seo_description = page_description | default: shop.description
  if request.page_type == 'index'
    if page_title == blank or page_title == shop.name
      assign seo_title = shop.name | append: ' | Homeopáticos y naturales en Colombia'
    endif
    if seo_description == blank
      assign seo_description = 'Productos homeopáticos, naturales, vitaminas y nutrición deportiva de laboratorios reconocidos. Desde Cali con envío a toda Colombia y asesoría por WhatsApp.'
    endif
  endif

  assign og_title = seo_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = seo_description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign og_image = page_image
  assign tarjeta = 'summary_large_image'
  if og_image == blank
    assign og_image = images['bif-logo.png']
    assign tarjeta = 'summary'
  endif

  assign no_indexar = false
  if current_tags or request.page_type == 'search'
    assign no_indexar = true
  endif
-%}

{%- if no_indexar -%}
  <meta
    name="robots"
    content="noindex, follow"
  >
{%- endif -%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:locale"
  content="es_CO"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if og_image != blank -%}
  <meta
    property="og:image"
    content="https:{{ og_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ og_image | image_url: width: 1200 }}"
  >
  <meta
    property="og:image:width"
    content="{{ og_image.width | at_most: 1200 }}"
  >
  <meta
    property="og:image:height"
    content="{{ og_image.height | times: 1200 | divided_by: og_image.width | at_most: og_image.height }}"
  >
  <meta
    property="og:image:alt"
    content="{{ og_image.alt | default: og_title | escape }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="{{ tarjeta }}"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>
{%- if og_image != blank -%}
  <meta
    name="twitter:image"
    content="https:{{ og_image | image_url: width: 1200 }}"
  >
{%- endif -%}

<title>
  {{ seo_title }}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; Página {{ current_page }}{% endif -%}
  {%- unless seo_title contains shop.name or seo_title contains 'BIF' %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{% if seo_description != blank %}
  <meta
    name="description"
    content="{{ seo_description | escape }}"
  >
{% endif %}
