{{ 'bif-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bif-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .bif-head h2 { font-size: {{ section.settings.titulo_tamano }}px; }
{% endstyle %}

{%- assign blog = section.settings.blog | default: blogs.noticias -%}

{%- if blog.articles_count > 0 or request.design_mode -%}
<section class="bif-blog bif-section">
  <div class="bif-container">
    <div class="bif-productos__top bif-head bif-reveal">
      <div>
        {%- if section.settings.antetitulo != blank -%}<span class="bif-eyebrow">{{ section.settings.antetitulo }}</span>{%- endif -%}
        {%- if section.settings.titulo != blank -%}<h2 style="margin-top:12px">{{ section.settings.titulo }}</h2>{%- endif -%}
      </div>
      {%- if blog -%}<a class="bif-btn bif-btn--primario" href="{{ blog.url }}">Ver el blog {% render 'bif-icono', nombre: 'flecha' %}</a>{%- endif -%}
    </div>
    <div class="bif-blog__grid">
      {%- for article in blog.articles limit: 3 -%}
        <a href="{{ article.url }}" class="bif-articulo bif-reveal" style="--bif-delay: {{ forloop.index0 | times: 0.1 }}s">
          <div class="bif-articulo__img">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy">{%- endif -%}
          </div>
          <div class="bif-articulo__cuerpo">
            <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d/%m/%Y' }}</time>
            <h3>{{ article.title }}</h3>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          </div>
        </a>
      {%- else -%}
        <div class="bif-vacio">Cuando publiques artículos en tu blog aparecerán aquí. (Este mensaje solo lo ves tú en el editor.)</div>
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "BIF – Blog",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "antetitulo", "label": "Texto pequeño superior", "default": "Blog de bienestar" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Consejos para vivir mejor" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "titulo_tamano", "label": "Tamaño del título (px)", "min": 22, "max": 60, "step": 2, "unit": "px", "default": 42 },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#FAF8F2" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [ { "name": "BIF – Blog" } ]
}
{% endschema %}
