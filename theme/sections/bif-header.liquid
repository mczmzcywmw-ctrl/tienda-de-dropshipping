{{ 'bif-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bif-scripts.js' | asset_url }}" defer></script>

{% style %}
  {%- if section.settings.fijo -%}
    #header-group { position: sticky; top: 0; z-index: 40; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .bif-logo img { width: {{ section.settings.logo_ancho }}px; }
  @media (max-width: 990px) { #shopify-section-{{ section.id }} .bif-logo img { width: {{ section.settings.logo_ancho | times: 0.78 | round }}px; } }
  #shopify-section-{{ section.id }} .bif-nav a { font-size: {{ section.settings.menu_tamano }}px; }
{% endstyle %}

<header class="bif-header bif-section">
  <div class="bif-container bif-header__fila">
    <a href="{{ routes.root_url }}" class="bif-logo" aria-label="{{ section.settings.nombre | default: shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 500 }}" alt="{{ section.settings.logo.alt | default: shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}">
      {%- else -%}
        <span class="bif-logo__marca">{% render 'bif-icono', nombre: 'hoja' %}</span>
        <span class="bif-logo__texto">
          <span class="bif-logo__nombre">{{ section.settings.nombre }}</span>
          {%- if section.settings.subtitulo != blank -%}<span class="bif-logo__sub">{{ section.settings.subtitulo }}</span>{%- endif -%}
        </span>
      {%- endif -%}
    </a>

    <nav class="bif-nav-wrap" aria-label="Menú principal">
      <ul class="bif-nav">
        {%- for link in section.settings.menu.links -%}
          {%- if link.links.size > 0 -%}
            <li class="bif-nav__desplegable">
              <button type="button" class="bif-nav__boton{% if link.child_active %} is-activo{% endif %}" aria-haspopup="true" aria-expanded="false">
                {{ link.title }} {% render 'bif-icono', nombre: 'abajo' %}
              </button>
              <div class="bif-nav__panel">
                <ul>
                  {%- for sub in link.links -%}
                    <li><a href="{{ sub.url }}" {% if sub.current %}aria-current="page"{% endif %}>{{ sub.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            </li>
          {%- else -%}
            <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>

    <div class="bif-header__iconos">
      <a href="{{ routes.search_url }}" class="bif-icono-btn" aria-label="Buscar">{% render 'bif-icono', nombre: 'buscar' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="bif-icono-btn bif-icono-btn--cuenta" aria-label="Mi cuenta">{% render 'bif-icono', nombre: 'usuario' %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="bif-icono-btn" aria-label="Carrito ({{ cart.item_count }})">
        {% render 'bif-icono', nombre: 'bolsa' %}
        {%- if cart.item_count > 0 -%}<span class="bif-burbuja">{{ cart.item_count }}</span>{%- endif -%}
      </a>
      <details class="bif-menu-movil">
        <summary class="bif-icono-btn" aria-label="Abrir menú">{% render 'bif-icono', nombre: 'menu' %}</summary>
        <div class="bif-menu-movil__panel">
          {%- for link in section.settings.menu.links -%}
            {%- if link.links.size > 0 -%}
              <details class="bif-movil__grupo">
                <summary>{{ link.title }} {% render 'bif-icono', nombre: 'abajo' %}</summary>
                {%- for sub in link.links -%}
                  <a href="{{ sub.url }}">{{ sub.title }}</a>
                {%- endfor -%}
              </details>
            {%- else -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.whatsapp != blank -%}
            <a class="bif-btn bif-btn--verde" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{% render 'bif-icono', nombre: 'whatsapp' %} Escríbenos por WhatsApp</a>
          {%- endif -%}
        </div>
      </details>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "BIF – Encabezado",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Imagen del logo (opcional)", "info": "Si no subes un logo, se muestra el nombre con una hoja." },
    { "type": "range", "id": "logo_ancho", "label": "Ancho del logo (px)", "min": 60, "max": 260, "step": 5, "unit": "px", "default": 140 },
    { "type": "text", "id": "nombre", "label": "Nombre de la tienda", "default": "BIF" },
    { "type": "text", "id": "subtitulo", "label": "Texto debajo del nombre", "default": "Tienda de Bienestar" },
    { "type": "header", "content": "Menú" },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" },
    { "type": "range", "id": "menu_tamano", "label": "Tamaño del menú (px)", "min": 12, "max": 18, "step": 1, "unit": "px", "default": 15 },
    { "type": "checkbox", "id": "fijo", "label": "Dejar el encabezado fijo al bajar", "default": true },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (menú del celular)", "default": "573173570881" }
  ]
}
{% endschema %}
