{{ 'bif-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bif-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    --bif-caja-a: {{ section.settings.color_a }};
    --bif-caja-b: {{ section.settings.color_b }};
  }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px; }
  }
{% endstyle %}

<section class="bif-confianza bif-section">
  <div class="bif-container bif-confianza__grid">
    <div class="bif-confianza__caja bif-reveal">
      {%- if section.settings.antetitulo != blank -%}<span class="bif-antetitulo">{{ section.settings.antetitulo }}</span>{%- endif -%}
      <h2 class="bif-confianza__frase">{{ section.settings.cita }}</h2>
      {%- if section.settings.texto != blank -%}<p class="bif-confianza__texto">{{ section.settings.texto | newline_to_br }}</p>{%- endif -%}
      <div class="bif-hero__botones">
        {%- if section.settings.boton_texto != blank and section.settings.whatsapp != blank -%}
          <a class="bif-btn bif-btn--blanco" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{% render 'bif-icono', nombre: 'whatsapp' %} {{ section.settings.boton_texto }}</a>
        {%- endif -%}
      </div>
    </div>

    <div>
      {%- if section.settings.titulo_lista != blank -%}
        <div class="bif-titulo bif-titulo--izq bif-reveal" style="margin-bottom:36px">
          {%- if section.settings.antetitulo_lista != blank -%}<span class="bif-antetitulo">{{ section.settings.antetitulo_lista }}</span>{%- endif -%}
          <h2>{{ section.settings.titulo_lista }}</h2>
        </div>
      {%- endif -%}
      <div class="bif-confianza__lista">
        {%- for block in section.blocks -%}
          <div class="bif-razon bif-reveal" style="--bif-delay: {{ forloop.index0 | times: 0.1 }}s" {{ block.shopify_attributes }}>
            <span class="bif-razon__num">{{ forloop.index | prepend: '0' }}</span>
            <div>
              <h3>{{ block.settings.titulo }}</h3>
              {%- if block.settings.texto != blank -%}<p>{{ block.settings.texto }}</p>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BIF – Por qué elegirnos",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Caja verde" },
    { "type": "text", "id": "antetitulo", "label": "Texto pequeño superior", "default": "Nuestra promesa" },
    { "type": "textarea", "id": "cita", "label": "Frase principal", "default": "Creemos que el bienestar se construye con productos confiables y personas que te escuchan." },
    { "type": "textarea", "id": "texto", "label": "Texto" },
    { "type": "text", "id": "boton_texto", "label": "Botón WhatsApp – texto", "default": "Habla con un asesor" },
    { "type": "text", "id": "whatsapp", "label": "Número de WhatsApp", "default": "573173570881" },
    { "type": "header", "content": "Lista" },
    { "type": "text", "id": "antetitulo_lista", "label": "Texto pequeño superior", "default": "¿Por qué BIF?" },
    { "type": "text", "id": "titulo_lista", "label": "Título", "default": "Razones para confiar en nosotros" },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "color_a", "label": "Color de la caja 1", "default": "#477E33" },
    { "type": "color", "id": "color_b", "label": "Color de la caja 2", "default": "#1F3B17" },
    { "type": "color", "id": "fondo", "label": "Color de fondo de la sección", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    { "type": "razon", "name": "Razón", "limit": 5, "settings": [
      { "type": "text", "id": "titulo", "label": "Título", "default": "Productos seleccionados" },
      { "type": "textarea", "id": "texto", "label": "Texto", "default": "Elegimos cada producto pensando en tu salud." }
    ] }
  ],
  "presets": [ { "name": "BIF – Por qué elegirnos", "blocks": [ { "type": "razon" } ] } ]
}
{% endschema %}
