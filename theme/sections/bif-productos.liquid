{{ 'bif-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bif-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  #shopify-section-{{ section.id }} .bif-head h2 { font-size: {{ section.settings.titulo_tamano }}px; }
  #shopify-section-{{ section.id }} .bif-productos__grid { --bif-cols: {{ section.settings.columnas }}; }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .bif-head h2 { font-size: {{ section.settings.titulo_tamano | times: 0.75 | round }}px; }
  }
{% endstyle %}

{%- liquid
  assign coleccion = section.settings.coleccion
  if coleccion == blank
    assign coleccion = collections.all
  endif
  assign ver_todo = coleccion.url | default: routes.all_products_collection_url
-%}

<section class="bif-productos bif-section">
  <div class="bif-container">
    <div class="bif-productos__top bif-head bif-reveal">
      <div>
        {%- if section.settings.antetitulo != blank -%}<span class="bif-eyebrow">{{ section.settings.antetitulo }}</span>{%- endif -%}
        {%- if section.settings.titulo != blank -%}<h2 style="margin-top:12px">{{ section.settings.titulo }}</h2>{%- endif -%}
        {%- if section.settings.texto != blank -%}<p>{{ section.settings.texto }}</p>{%- endif -%}
      </div>
      {%- if section.settings.boton_texto != blank -%}
        <a class="bif-btn bif-btn--primario" href="{{ ver_todo }}">{{ section.settings.boton_texto }} {% render 'bif-icono', nombre: 'flecha' %}</a>
      {%- endif -%}
    </div>

    <div class="bif-productos__grid">
      {%- for product in coleccion.products limit: section.settings.cantidad -%}
        {%- assign variante = product.selected_or_first_available_variant -%}
        <article class="bif-card bif-reveal" style="--bif-delay: {{ forloop.index0 | modulo: 4 | times: 0.08 }}s">
          <a href="{{ product.url }}" class="bif-card__media" aria-label="{{ product.title | escape }}">
            {%- unless product.available -%}
              <span class="bif-card__etiqueta bif-card__etiqueta--agotado">Agotado</span>
            {%- else -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="bif-card__etiqueta">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
              {%- endif -%}
            {%- endunless -%}
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
              {%- if section.settings.segunda_foto and product.images.size > 1 -%}
                <img src="{{ product.images[1] | image_url: width: 700 }}" alt="" loading="lazy">
              {%- endif -%}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag }}
            {%- endif -%}
          </a>
          <div class="bif-card__cuerpo">
            {%- if product.type != blank -%}<span class="bif-card__tipo">{{ product.type }}</span>{%- endif -%}
            <h3 class="bif-card__titulo"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <div class="bif-card__precio">
              {%- if product.price_varies -%}Desde {% endif -%}{{ product.price | money }}
              {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
            </div>
            {%- if product.available and product.has_only_default_variant and section.settings.mostrar_agregar -%}
              <form method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ variante.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="bif-btn bif-btn--primario">{% render 'bif-icono', nombre: 'bolsa' %} Agregar al carrito</button>
              </form>
            {%- else -%}
              <a class="bif-btn bif-btn--primario" href="{{ product.url }}">Ver producto</a>
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        <div class="bif-vacio">Aquí aparecerán tus productos en cuanto los agregues a la tienda.</div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BIF – Productos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "antetitulo", "label": "Texto pequeño superior", "default": "Lo más buscado" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Nuestros productos" },
    { "type": "text", "id": "texto", "label": "Texto" },
    { "type": "collection", "id": "coleccion", "label": "Colección a mostrar", "info": "Si la dejas vacía se muestran todos los productos." },
    { "type": "range", "id": "cantidad", "label": "Cantidad de productos", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "range", "id": "columnas", "label": "Columnas en computador", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "mostrar_agregar", "label": "Botón 'Agregar al carrito' en la tarjeta", "default": true },
    { "type": "checkbox", "id": "segunda_foto", "label": "Mostrar segunda foto al pasar el mouse", "default": true },
    { "type": "text", "id": "boton_texto", "label": "Botón 'ver todo' – texto", "default": "Ver todos" },
    { "type": "range", "id": "titulo_tamano", "label": "Tamaño del título (px)", "min": 22, "max": 60, "step": 2, "unit": "px", "default": 42 },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#FFFFFF" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "BIF – Productos" } ]
}
{% endschema %}
