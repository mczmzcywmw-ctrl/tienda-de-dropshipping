{{ 'bif-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bif-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.fondo }};
    padding-top: {{ section.settings.padding }}px;
    padding-bottom: {{ section.settings.padding }}px;
  }
  #shopify-section-{{ section.id }} .bif-anuncio { color: {{ section.settings.texto_color }}; font-size: {{ section.settings.tamano }}px; }
{% endstyle %}

{%- if section.blocks.size > 0 -%}
  <div class="bif-anuncio bif-section" style="--bif-anuncio-vel: {{ section.settings.segundos | times: 8 }}s">
    <div class="bif-anuncio__cinta" aria-label="{% for block in section.blocks %}{{ block.settings.texto | escape }}{% unless forloop.last %} · {% endunless %}{% endfor %}">
      <div class="bif-anuncio__pista">
        {%- for vuelta in (1..4) -%}
          <div class="bif-anuncio__grupo" {% if vuelta > 1 %}aria-hidden="true"{% endif %}>
            {%- for block in section.blocks -%}
              <span class="bif-anuncio__frase" {% if vuelta == 1 %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.enlace != blank -%}<a href="{{ block.settings.enlace }}">{{ block.settings.texto }}</a>{%- else -%}{{ block.settings.texto }}{%- endif -%}
              </span>
              <span class="bif-anuncio__sep" aria-hidden="true">{% render 'bif-icono', nombre: 'hoja' %}</span>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "BIF – Barra de anuncio",
  "tag": "div",
  "settings": [
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#1F3B17" },
    { "type": "color", "id": "texto_color", "label": "Color del texto", "default": "#FFFFFF" },
    { "type": "range", "id": "tamano", "label": "Tamaño del texto (px)", "min": 11, "max": 17, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "segundos", "label": "Velocidad del movimiento (más alto = más lento)", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "padding", "label": "Espacio arriba y abajo (px)", "min": 4, "max": 20, "step": 1, "unit": "px", "default": 10 }
  ],
  "blocks": [
    {
      "type": "frase",
      "name": "Frase",
      "settings": [
        { "type": "text", "id": "texto", "label": "Texto", "default": "Bienestar natural para ti y tu familia" },
        { "type": "url", "id": "enlace", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [ { "name": "BIF – Barra de anuncio", "blocks": [ { "type": "frase" } ] } ]
}
{% endschema %}
