{{ 'bif-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.fondo }};
    padding-top: {{ section.settings.padding }}px;
    padding-bottom: {{ section.settings.padding }}px;
  }
  #shopify-section-{{ section.id }} .bif-anuncio { color: {{ section.settings.texto_color }}; font-size: {{ section.settings.tamano }}px; }
  #shopify-section-{{ section.id }} .bif-anuncio__pista { --bif-velocidad: {{ section.settings.velocidad }}s; }
{% endstyle %}

{%- liquid
  assign frases = ''
  for block in section.blocks
    if block.settings.texto != blank
      assign frases = frases | append: block.settings.texto | append: '|||'
    endif
  endfor
  assign lista = frases | split: '|||'
-%}

{%- if lista.size > 0 -%}
  <div class="bif-anuncio bif-section" {{ section.shopify_attributes }}>
    <div class="bif-anuncio__pista">
      {%- for vuelta in (1..2) -%}
        {%- for i in (1..3) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.texto != blank -%}
              <span class="bif-anuncio__item" {% if vuelta == 1 and i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                {%- if block.settings.enlace != blank -%}
                  <a href="{{ block.settings.enlace }}" style="color:inherit">{{ block.settings.texto }}</a>
                {%- else -%}
                  {{ block.settings.texto }}
                {%- endif -%}
              </span>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "BIF – Barra de anuncio",
  "tag": "div",
  "class": "bif-anuncio-wrap",
  "settings": [
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#1E3A15" },
    { "type": "color", "id": "texto_color", "label": "Color del texto", "default": "#FFFFFF" },
    { "type": "range", "id": "tamano", "label": "Tamaño del texto (px)", "min": 11, "max": 18, "step": 1, "unit": "px", "default": 13 },
    { "type": "range", "id": "velocidad", "label": "Velocidad (más alto = más lento)", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 35 },
    { "type": "range", "id": "padding", "label": "Espacio arriba y abajo (px)", "min": 4, "max": 24, "step": 1, "unit": "px", "default": 11 }
  ],
  "blocks": [
    {
      "type": "frase",
      "name": "Frase",
      "settings": [
        { "type": "text", "id": "texto", "label": "Texto", "default": "🌿 Bienestar natural para ti y tu familia" },
        { "type": "url", "id": "enlace", "label": "Enlace (opcional)" }
      ]
    }
  ],
  "presets": [ { "name": "BIF – Barra de anuncio", "blocks": [ { "type": "frase" } ] } ]
}
{% endschema %}
