{{ 'bif-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bif-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.fondo }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if section.settings.linea %} border-bottom: 1px solid #DCE6D5;{% endif %}
  }
  {%- liquid
    assign columnas = section.blocks.size | at_most: 5 | at_least: 1
    if section.blocks.size == 6
      assign columnas = 3
    endif
  -%}
  #shopify-section-{{ section.id }} .bif-beneficios__fila { --bif-cols: {{ columnas }}; }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} { padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px; }
  }
{% endstyle %}

<section class="bif-beneficios bif-section">
  <div class="bif-container">
    {%- if section.settings.titulo != blank -%}
      <div class="bif-titulo bif-reveal">
        {%- if section.settings.antetitulo != blank -%}<span class="bif-antetitulo">{{ section.settings.antetitulo }}</span>{%- endif -%}
        <h2>{{ section.settings.titulo }}</h2>
      </div>
    {%- endif -%}
    <div class="bif-beneficios__fila">
      {%- for block in section.blocks -%}
        <div class="bif-beneficio bif-reveal" style="--bif-delay: {{ forloop.index0 | times: 0.07 }}s" {{ block.shopify_attributes }}>
          <div class="bif-beneficio__icono">{% render 'bif-icono', nombre: block.settings.icono %}</div>
          <h3>{{ block.settings.titulo }}</h3>
          {%- if block.settings.texto != blank -%}<p>{{ block.settings.texto }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BIF – Beneficios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "antetitulo", "label": "Texto pequeño superior" },
    { "type": "text", "id": "titulo", "label": "Título (opcional)" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "default": "#FFFFFF" },
    { "type": "checkbox", "id": "linea", "label": "Línea divisoria abajo", "default": true },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "limit": 8,
      "settings": [
        { "type": "select", "id": "icono", "label": "Ícono", "options": [
          { "value": "camion", "label": "Camión (envíos)" },
          { "value": "candado", "label": "Candado (pagos seguros)" },
          { "value": "atencion", "label": "Audífonos (atención)" },
          { "value": "escudo", "label": "Escudo (bioseguridad)" },
          { "value": "hoja", "label": "Hoja (natural)" },
          { "value": "corazon", "label": "Corazón (salud)" },
          { "value": "estrella", "label": "Estrella (calidad)" },
          { "value": "gota", "label": "Gota" },
          { "value": "pesa", "label": "Pesa (deporte)" }
        ], "default": "hoja" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Enfoque natural" },
        { "type": "textarea", "id": "texto", "label": "Texto" }
      ]
    }
  ],
  "presets": [ { "name": "BIF – Beneficios", "blocks": [ { "type": "beneficio" } ] } ]
}
{% endschema %}
