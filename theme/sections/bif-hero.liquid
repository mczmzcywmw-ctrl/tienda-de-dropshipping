{{ 'bif-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bif-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: 0;
    padding-bottom: 0;
    --bif-hero-a: {{ section.settings.color_a }};
    --bif-hero-b: {{ section.settings.color_b }};
  }
  #shopify-section-{{ section.id }} .bif-hero__grid { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} h1 { font-size: {{ section.settings.titulo_tamano }}px; }
  #shopify-section-{{ section.id }} .bif-hero__texto { font-size: {{ section.settings.texto_tamano }}px; }
  #shopify-section-{{ section.id }} .bif-hero__contenido { text-align: {{ section.settings.alineacion }}; }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} h1 { font-size: {{ section.settings.titulo_tamano | times: 0.68 | round }}px; }
    #shopify-section-{{ section.id }} .bif-hero__grid { padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px; }
  }
{% endstyle %}

{%- liquid
  assign imagen = section.settings.imagen
  assign modo_contain = false
  if imagen == blank
    assign imagen = collections.all.products.first.featured_image
    assign modo_contain = true
  endif
-%}

<section class="bif-hero bif-section">
  <div class="bif-hero__fondo"></div>
  <svg class="bif-hero__hojas" viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <g fill="none" stroke="#fff" stroke-width="1.5">
      <path d="M60 520C120 380 260 330 360 360 300 450 180 520 60 520Z"/><path d="M60 520C160 460 250 410 360 360"/>
      <path d="M700 90C640 200 520 240 440 210 480 130 590 80 700 90Z"/><path d="M700 90C620 140 540 180 440 210"/>
      <path d="M740 520c-50-90-150-120-220-100 40 70 130 110 220 100Z"/><path d="M740 520c-70-50-140-80-220-100"/>
    </g>
  </svg>

  <div class="bif-container bif-hero__grid">
    <div class="bif-hero__contenido">
      {%- if section.settings.antetitulo != blank -%}
        <span class="bif-eyebrow bif-reveal">{{ section.settings.antetitulo }}</span>
      {%- endif -%}
      <h1 class="bif-reveal" style="--bif-delay:.08s">{{ section.settings.titulo }}</h1>
      <p class="bif-hero__texto bif-reveal" style="--bif-delay:.16s">{{ section.settings.texto | newline_to_br }}</p>

      <div class="bif-hero__botones bif-reveal" style="--bif-delay:.24s">
        {%- if section.settings.boton1_texto != blank -%}
          <a class="bif-btn bif-btn--claro" href="{{ section.settings.boton1_enlace | default: routes.all_products_collection_url }}">
            {{ section.settings.boton1_texto }} {% render 'bif-icono', nombre: 'flecha' %}
          </a>
        {%- endif -%}
        {%- if section.settings.boton2_texto != blank and section.settings.whatsapp != blank -%}
          <a class="bif-btn bif-btn--borde" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">
            {% render 'bif-icono', nombre: 'whatsapp' %} {{ section.settings.boton2_texto }}
          </a>
        {%- endif -%}
      </div>

      <div class="bif-hero__chips bif-reveal" style="--bif-delay:.32s">
        {%- for block in section.blocks -%}
          <span class="bif-hero__chip" {{ block.shopify_attributes }}>{% render 'bif-icono', nombre: 'check' %} {{ block.settings.texto }}</span>
        {%- endfor -%}
      </div>
    </div>

    <div class="bif-hero__visual bif-reveal" style="--bif-delay:.2s">
      <div class="bif-hero__marco{% if modo_contain %} bif-hero__marco--contain{% endif %}">
        {%- if imagen != blank -%}
          <img src="{{ imagen | image_url: width: 1200 }}" alt="{{ imagen.alt | escape }}" width="{{ imagen.width }}" height="{{ imagen.height }}" loading="eager" fetchpriority="high">
        {%- else -%}
          <div class="bif-hero__placeholder">{% render 'bif-icono', nombre: 'hoja' %}</div>
        {%- endif -%}
      </div>
      {%- if section.settings.flotante1_titulo != blank -%}
        <div class="bif-flotante bif-flotante--1">
          <span class="bif-flotante__icono">{% render 'bif-icono', nombre: 'hoja' %}</span>
          <span><strong>{{ section.settings.flotante1_titulo }}</strong>{{ section.settings.flotante1_texto }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.flotante2_titulo != blank -%}
        <div class="bif-flotante bif-flotante--2">
          <span class="bif-flotante__icono">{% render 'bif-icono', nombre: 'camion' %}</span>
          <span><strong>{{ section.settings.flotante2_titulo }}</strong>{{ section.settings.flotante2_texto }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BIF – Bienvenida",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "antetitulo", "label": "Texto pequeño superior", "default": "Bienvenido a BIF" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Tu bienestar, en manos de la naturaleza" },
    { "type": "textarea", "id": "texto", "label": "Frase de confianza", "default": "Productos homeopáticos, naturales y suplementos seleccionados con cuidado para acompañarte en cada etapa de tu salud." },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "boton1_texto", "label": "Botón principal – texto", "default": "Ver productos" },
    { "type": "url", "id": "boton1_enlace", "label": "Botón principal – enlace" },
    { "type": "text", "id": "boton2_texto", "label": "Botón WhatsApp – texto", "default": "Recibe asesoría" },
    { "type": "text", "id": "whatsapp", "label": "Número de WhatsApp (con indicativo)", "default": "573173570881" },
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "imagen", "label": "Imagen principal", "info": "Si la dejas vacía se muestra la foto de tu primer producto." },
    { "type": "header", "content": "Tarjetas flotantes" },
    { "type": "text", "id": "flotante1_titulo", "label": "Tarjeta 1 – título", "default": "Enfoque natural" },
    { "type": "text", "id": "flotante1_texto", "label": "Tarjeta 1 – texto", "default": "Cuidado suave y consciente" },
    { "type": "text", "id": "flotante2_titulo", "label": "Tarjeta 2 – título", "default": "Envíos a todo el país" },
    { "type": "text", "id": "flotante2_texto", "label": "Tarjeta 2 – texto", "default": "Recíbelo en la puerta de tu casa" },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "color_a", "label": "Color de fondo 1", "default": "#477E33" },
    { "type": "color", "id": "color_b", "label": "Color de fondo 2", "default": "#1E3A15" },
    { "type": "select", "id": "alineacion", "label": "Alineación del texto", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "range", "id": "titulo_tamano", "label": "Tamaño del título (px)", "min": 32, "max": 88, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "texto_tamano", "label": "Tamaño de la frase (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 112 }
  ],
  "blocks": [
    { "type": "chip", "name": "Punto de confianza", "settings": [ { "type": "text", "id": "texto", "label": "Texto", "default": "Pagos 100% seguros" } ] }
  ],
  "presets": [ { "name": "BIF – Bienvenida", "blocks": [ { "type": "chip" } ] } ]
}
{% endschema %}
