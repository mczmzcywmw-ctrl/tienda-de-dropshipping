{{ 'bif-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bif-scripts.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    --bif-hero-a: {{ section.settings.color_a }};
    --bif-hero-b: {{ section.settings.color_b }};
  }
  #shopify-section-{{ section.id }} .bif-hero__grid { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  #shopify-section-{{ section.id }} h1 { font-size: {{ section.settings.titulo_tamano }}px; }
  #shopify-section-{{ section.id }} .bif-hero__texto { font-size: {{ section.settings.texto_tamano }}px; }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .bif-hero__grid { padding-top: {{ section.settings.padding_top | times: 0.6 | round }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round }}px; }
    #shopify-section-{{ section.id }} h1 { font-size: {{ section.settings.titulo_tamano | times: 0.72 | round }}px; }
  }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} h1 { font-size: {{ section.settings.titulo_tamano | times: 0.6 | round }}px; }
    #shopify-section-{{ section.id }} .bif-hero__texto { font-size: {{ section.settings.texto_tamano | minus: 1 }}px; }
  }
{% endstyle %}

<section class="bif-hero bif-section" data-bif-hero>
  <div class="bif-hero__blob bif-hero__blob--1"></div>
  <div class="bif-hero__blob bif-hero__blob--2"></div>
  <div class="bif-hero__particulas" aria-hidden="true">
    {%- for i in (1..9) -%}
      <span class="bif-particula" style="--i: {{ i }}">{% render 'bif-icono', nombre: 'hoja' %}</span>
    {%- endfor -%}
  </div>

  <div class="bif-hero__luz" aria-hidden="true"></div>
  <div class="bif-container bif-hero__grid">
    <div>
      {%- if section.settings.antetitulo != blank -%}
        <span class="bif-hero__pildora bif-reveal">
          <span class="bif-hero__punto"></span>{{ section.settings.antetitulo }}
        </span>
      {%- endif -%}
      {%- liquid
        assign rotan = section.settings.palabras_rotan | split: ','
        assign partes = section.settings.titulo | split: ' '
        assign ultima = partes | last
        assign base = section.settings.titulo | remove_last: ultima | strip
      -%}
      {%- if rotan.size > 1 -%}
        <h1 class="bif-hero__titulo" aria-label="{{ section.settings.titulo | escape }}">
          <span class="bif-palabras" aria-hidden="true">{{ base }}</span>
          <span class="bif-rota" data-bif-rota aria-hidden="true">
            {%- for palabra in rotan -%}
              <span class="bif-rota__palabra{% if forloop.first %} is-activa{% endif %}">{{ palabra | strip }}</span>
            {%- endfor -%}
            <svg class="bif-rota__trazo" viewBox="0 0 300 20" preserveAspectRatio="none" fill="none"><path d="M3 15C60 5 150 3 297 11" pathLength="1" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
          </span>
        </h1>
      {%- else -%}
        <h1 class="bif-palabras">{{ section.settings.titulo }}</h1>
      {%- endif -%}
      {%- if section.settings.texto != blank -%}
        <p class="bif-hero__texto bif-reveal" style="--bif-delay:.5s">{{ section.settings.texto | newline_to_br }}</p>
      {%- endif -%}
      <div class="bif-hero__botones bif-reveal" style="--bif-delay:.65s">
        {%- if section.settings.boton1_texto != blank -%}
          <a class="bif-btn bif-btn--blanco bif-btn--brillo" href="{{ section.settings.boton1_enlace | default: routes.all_products_collection_url }}">{{ section.settings.boton1_texto }} {% render 'bif-icono', nombre: 'flecha' %}</a>
        {%- endif -%}
        {%- if section.settings.boton2_texto != blank and section.settings.whatsapp != blank -%}
          <a class="bif-btn bif-btn--linea-blanca" href="https://wa.me/{{ section.settings.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener">{% render 'bif-icono', nombre: 'whatsapp' %} {{ section.settings.boton2_texto }}</a>
        {%- endif -%}
      </div>
      {%- assign garantias = section.blocks | where: 'type', 'garantia' -%}
      {%- if garantias.size > 0 -%}
        <ul class="bif-hero__garantias bif-reveal" style="--bif-delay:.8s">
          {%- for block in garantias -%}
            <li {{ block.shopify_attributes }}>{% render 'bif-icono', nombre: 'check' %} {{ block.settings.texto }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- assign cifras = section.blocks | where: 'type', 'cifra' -%}
      {%- if cifras.size > 0 -%}
        <div class="bif-hero__cifras bif-reveal" style="--bif-delay:.95s">
          {%- for block in cifras -%}
            <div class="bif-hero__cifra" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.prefijo }}<span{% if block.settings.contar %} data-bif-contar="{{ block.settings.numero }}"{% endif %}>{% if block.settings.contar %}0{% else %}{{ block.settings.numero }}{% endif %}</span>{{ block.settings.sufijo }}</strong>
              <span>{{ block.settings.texto }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="bif-hero__visual bif-reveal" style="--bif-delay:.25s">
      {%- if section.settings.imagen != blank -%}
        <div class="bif-hero__foto">
          <img src="{{ section.settings.imagen | image_url: width: 1200 }}" alt="{{ section.settings.imagen.alt | escape }}" width="{{ section.settings.imagen.width }}" height="{{ section.settings.imagen.height }}" loading="eager" fetchpriority="high">
        </div>
      {%- else -%}
        <div class="bif-arte" aria-hidden="true">
          <span class="bif-arte__anillo bif-arte__anillo--1"></span>
          <span class="bif-arte__anillo bif-arte__anillo--2"></span>
          <span class="bif-arte__anillo bif-arte__anillo--3"></span>
          <div class="bif-arte__orbita">
            {%- assign iconos = 'hoja,pesa,gota,corazon' | split: ',' -%}
            {%- for icono in iconos -%}
              <span class="bif-arte__burbuja bif-arte__burbuja--{{ forloop.index }}"><span>{% render 'bif-icono', nombre: icono %}</span></span>
            {%- endfor -%}
          </div>
          <div class="bif-arte__centro">
            <svg class="bif-arte__planta" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path class="bif-trazo" d="M60 104V52"/>
              <path class="bif-trazo" style="--d:.3s" d="M60 70C60 54 48 42 30 40c0 18 12 30 30 30Z"/>
              <path class="bif-trazo" style="--d:.6s" d="M60 58c0-18 13-32 32-34 0 20-13 34-32 34Z"/>
              <path class="bif-trazo" style="--d:.9s" d="M60 86c0-10 8-18 20-19 0 11-8 19-20 19Z"/>
              <path class="bif-trazo" style="--d:1.1s" d="M40 104h40"/>
            </svg>
            <strong>{{ section.settings.centro_titulo }}</strong>
            <span>{{ section.settings.centro_texto }}</span>
          </div>
        </div>
      {%- endif -%}
      {%- assign destacado = section.settings.producto | default: collections.all.products.first -%}
      {%- if section.settings.mostrar_producto and destacado != blank -%}
        <a class="bif-hero__producto" href="{{ destacado.url }}">
          <span class="bif-hero__producto-img">
            {%- if destacado.featured_image -%}<img src="{{ destacado.featured_image | image_url: width: 240 }}" alt="{{ destacado.featured_image.alt | default: destacado.title | escape }}" width="120" height="120" loading="eager">{%- endif -%}
          </span>
          <span class="bif-hero__producto-info">
            <small>{{ section.settings.producto_etiqueta }}</small>
            <strong>{{ destacado.title }}</strong>
            <span class="bif-hero__producto-precio">
              {%- if destacado.compare_at_price > destacado.price -%}<s>{{ destacado.compare_at_price | money }}</s> {% endif -%}
              {{ destacado.price | money }}
            </span>
          </span>
          <span class="bif-hero__producto-ir" aria-hidden="true">{% render 'bif-icono', nombre: 'flecha' %}</span>
        </a>
      {%- endif -%}
      <div class="bif-hero__tarjetas">
      {%- if section.settings.tarjeta1_titulo != blank -%}
        <div class="bif-flota bif-flota--1">
          <span class="bif-flota__icono">{% render 'bif-icono', nombre: 'camion' %}</span>
          <span><strong>{{ section.settings.tarjeta1_titulo }}</strong>{{ section.settings.tarjeta1_texto }}</span>
        </div>
      {%- endif -%}
      {%- if section.settings.tarjeta2_titulo != blank -%}
        <div class="bif-flota bif-flota--2">
          <span class="bif-flota__icono">{% render 'bif-icono', nombre: 'escudo' %}</span>
          <span><strong>{{ section.settings.tarjeta2_titulo }}</strong>{{ section.settings.tarjeta2_texto }}</span>
        </div>
      {%- endif -%}
      </div>
    </div>
  </div>
  {%- if section.settings.mostrar_bajar -%}
    <div class="bif-hero__bajar" aria-hidden="true"><span class="bif-hero__raton"><span></span></span>{{ section.settings.bajar_texto }}</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "BIF – Bienvenida",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "antetitulo", "label": "Texto pequeño superior", "default": "Bienvenido a BIF · Tienda de Bienestar" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Tu bienestar, en manos de la naturaleza" },
    { "type": "text", "id": "palabras_rotan", "label": "Palabras que cambian al final del título", "info": "Separadas por comas. Reemplazan la última palabra del título. Déjalo vacío para un título fijo.", "default": "naturaleza, confianza, tradición" },
    { "type": "textarea", "id": "texto", "label": "Frase de confianza", "default": "Productos homeopáticos, naturales y suplementos seleccionados con cuidado para acompañarte en cada etapa de tu salud." },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "boton1_texto", "label": "Botón principal – texto", "default": "Ver productos" },
    { "type": "url", "id": "boton1_enlace", "label": "Botón principal – enlace" },
    { "type": "text", "id": "boton2_texto", "label": "Botón WhatsApp – texto", "default": "Recibe asesoría" },
    { "type": "text", "id": "whatsapp", "label": "Número de WhatsApp (con indicativo)", "default": "573173570881" },
    { "type": "header", "content": "Ilustración" },
    { "type": "image_picker", "id": "imagen", "label": "Foto (opcional)", "info": "Si subes una foto, reemplaza la ilustración animada." },
    { "type": "text", "id": "centro_titulo", "label": "Texto central", "default": "Bienestar natural" },
    { "type": "text", "id": "centro_texto", "label": "Texto central pequeño", "default": "Cuidado consciente" },
    { "type": "header", "content": "Producto destacado" },
    { "type": "checkbox", "id": "mostrar_producto", "label": "Mostrar un producto flotando junto a la ilustración", "default": false },
    { "type": "product", "id": "producto", "label": "Producto", "info": "Si no eliges uno, se muestra el primero de la tienda." },
    { "type": "text", "id": "producto_etiqueta", "label": "Etiqueta", "default": "Producto destacado" },
    { "type": "header", "content": "Tarjetas flotantes" },
    { "type": "text", "id": "tarjeta1_titulo", "label": "Tarjeta 1 – título", "default": "Envíos a todo el país" },
    { "type": "text", "id": "tarjeta1_texto", "label": "Tarjeta 1 – texto", "default": "Directo a tu puerta" },
    { "type": "text", "id": "tarjeta2_titulo", "label": "Tarjeta 2 – título", "default": "Compra 100% segura" },
    { "type": "text", "id": "tarjeta2_texto", "label": "Tarjeta 2 – texto", "default": "Pagos protegidos" },
    { "type": "header", "content": "Indicador para bajar" },
    { "type": "checkbox", "id": "mostrar_bajar", "label": "Mostrar indicador de \"desliza\"", "default": true },
    { "type": "text", "id": "bajar_texto", "label": "Texto", "default": "Descubre más" },
    { "type": "header", "content": "Diseño" },
    { "type": "color", "id": "color_a", "label": "Color de fondo 1", "default": "#477E33" },
    { "type": "color", "id": "color_b", "label": "Color de fondo 2", "default": "#1F3B17" },
    { "type": "range", "id": "titulo_tamano", "label": "Tamaño del título (px)", "min": 32, "max": 80, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "texto_tamano", "label": "Tamaño de la frase (px)", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 200, "step": 8, "unit": "px", "default": 112 }
  ],
  "blocks": [
    { "type": "garantia", "name": "Garantía", "limit": 4, "settings": [ { "type": "text", "id": "texto", "label": "Texto", "default": "Productos originales" } ] },
    { "type": "cifra", "name": "Cifra", "limit": 3, "settings": [
      { "type": "text", "id": "prefijo", "label": "Antes del número", "default": "+" },
      { "type": "number", "id": "numero", "label": "Número", "default": 1000 },
      { "type": "text", "id": "sufijo", "label": "Después del número" },
      { "type": "checkbox", "id": "contar", "label": "Animar el número contando", "default": true },
      { "type": "text", "id": "texto", "label": "Texto", "default": "Pacientes atendidos" }
    ] }
  ],
  "presets": [ { "name": "BIF – Bienvenida" } ]
}
{% endschema %}
